# ============================================
# Docker Compose - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e ajuste os valores conforme necessário
# cp .env.example .env

# ============================================
# PostgreSQL Database
# ============================================
POSTGRES_USER=agendamento_user
POSTGRES_PASSWORD=agendamento_password
POSTGRES_DB=agendamento_db
POSTGRES_PORT=5432

# ============================================
# Backend (FastAPI)
# ============================================
BACKEND_PORT=8000

# Security
SECRET_KEY=your-secret-key-change-in-production-please-use-a-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe (opcional - deixe vazio se não usar)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# WhatsApp (opcional - deixe vazio se não usar)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# CORS - URLs permitidas (formato JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80"]

# File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880

# ============================================
# Frontend (React/Vite)
# ============================================
FRONTEND_PORT=3000

# URL da API Backend (usado pelo frontend em build time)
VITE_API_URL=http://localhost:8000

